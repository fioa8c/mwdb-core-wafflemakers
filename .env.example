# Compose variables for docker-compose-prod.yml. Copy to .env (gitignored) and
# replace every placeholder. Use alphanumeric secrets only: REDIS_PASSWORD is
# embedded in a redis:// URI. Generate with:  openssl rand -hex 24

# Public hostname Traefik serves and requests a Let's Encrypt certificate for.
MWDB_DOMAIN=mwdb.example.com

# Contact email for Let's Encrypt notifications.
ACME_EMAIL=ops@example.com

# This droplet's VPC (private network) address. Redis (6379) and S3/silo (9000)
# are published on this address only, for the worker droplet. Compose refuses
# to start if it is unset, so they can never end up on all interfaces.
VPC_BIND_IP=10.116.0.2

# Redis password (Karton message bus and MWDB's own Redis).
REDIS_PASSWORD=change-me-redis

# S3 (silo/MinIO) root credentials for Karton's resource bucket. The worker
# droplet's karton.ini must carry the same pair.
SILO_ACCESS_KEY=change-me-silo-access
SILO_SECRET_KEY=change-me-silo-secret

# API key of the dedicated `karton` MWDB user, used by karton-mwdb-reporter.
# Create the user and key in MWDB first (DEPLOYMENT.md, "Karton and the worker
# droplet"); until then any non-empty value lets the stack start.
KARTON_MWDB_API_KEY=change-me-after-creating-karton-user

# Groups the malleus plugin grants attribute rights to. The defaults match the
# user/scanner account names in the runbook; omit to use them.
# Reporter (read+set on the Malleus attributes):
MWDB_MALLEUS_SET_GROUPS=karton
# Scanners (read on the attributes, set on `context`):
MWDB_MALLEUS_READ_GROUPS=jetpack-scan,wpcloud-scan,elderward
